}

post {
  url: {{url_admin}}/auth/reset-password
  body: json
  auth: bearer
}

params:query {
  ~token: 6985c1f08d38c5aeaea482cdfccaa39d4c843dc1c15244d3f6eced584c0afd34
  ~email: idsantri.online@gmail.com
  ~password: 123456
  ~password_confirmation: 123456
}

headers {
