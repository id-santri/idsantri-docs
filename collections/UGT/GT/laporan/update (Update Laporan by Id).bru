meta {
  name: update (Update Laporan by Id)
  type: http
  seq: 4
}

put {
  url: {{url_ugt_gt}}/laporan/9
  body: json
  auth: inherit
}

headers {
  Accept: application/json
}

body:json {
  {
    "config_id":"1447-1448-02",
    "wali_kelas":[
      {
        "tingkat":"Ibtidaiyah",
        "kelas":"6"        
      }
    ],
    "guru_fan":[
      {
        "tingkat":"Tsanawiyah",
        "kelas":"1"  
      },
      {
        "tingkat":"Ibtidaiyah",
        "kelas":"4"  
      }
    ],
    "sex_murid":"Perempuan",
    "absen":[
      {
        "sakit":1
      }
    ],
    "kegiatan":[
      {
        "quran":"ya", //atau true/false
        "kitab":"tidak" // atau true/false
      }
    ],
    "hubungan":[
      {
        "guru":"baik",
        "pjgt":"baik"
      }
    ],
    "bisyarah":[
      {
        "nominal":1000,
        "tepat_waktu":true // true/false
      }
    ],
    "usul_saran":"text panjang"
  }
}

tests {
  test('set token', () => {
      const responseJson = res.getBody();
      const { data } = responseJson;
      
      // Verifikasi bahwa data adalah sebuah object  
      test('Data should be an object', () => {  
          expect(data).to.be.an('object');  
      });  
  
       // Dapatkan token dari data  
      const token = data.token;  
       // Verifikasi bahwa token ada dan memenuhi kriteria  
      test('Token should exist, be a string, and have length more than 10', () => {  
          expect(token).to.be.a('string');  
          expect(token.length).to.be.above(10);  
      });  
  
     bru.setEnvVar('token_wali', token);
  });
}
